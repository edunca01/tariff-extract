# Copy to .env (gitignored). Never commit real values.

# OpenEI URDB: https://openei.org/services/api/signup/
OPENEI_API_KEY=

# Anthropic API key. Needed only for the `large` and `small` rows.
# Not needed for `make demo` (cached responses), `make check` (CI never calls an LLM),
# or the `local` row.
ANTHROPIC_API_KEY=

# Ollama server for the `local` row. Default is the local machine.
# On the GPU box leave it unset; from another machine on the LAN point it at the box.
# OLLAMA_HOST=http://localhost:11434

# Override the local model tag without editing config.toml (must be pulled: ollama pull <tag>).
# TARIFF_LOCAL_MODEL=gemma4:26b

# Optional path overrides (defaults in config.toml)
# TARIFF_CACHE_DIR=./cache
# TARIFF_RESULTS_DIR=./results

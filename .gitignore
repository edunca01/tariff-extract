# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
build/
dist/

# Secrets and local env
.env
.env.*
!.env.example

# Claude Code: personal settings stay local; shared settings + hooks are committed
.claude/settings.local.json

# Corpus PDFs are published as a release asset, not committed.
# Only the manifest and the three demo PDFs live in git.
corpus/pdfs/
corpus/text/

# LLM response cache: only the demo-doc entries are committed (make demo needs them)
cache/*
!cache/.gitkeep
!cache/demo/

# Eval outputs and reports are regenerated by `make eval` / `make report`
results/
reports/

# OS / editor
.DS_Store
.idea/
.vscode/
